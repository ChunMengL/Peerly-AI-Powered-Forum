NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Newer Supabase dashboards may call the anon key a publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Server-only. Use only for trusted backend/admin tasks, never in client components.
# Can be ignored, only for admin tasks.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Server-only. Base URL of the fine-tuned tutor model server (POST {url}/tutor).
# Leave unset to use the built-in deterministic mock tutor.
MODEL_SERVER_URL=http://localhost:8000